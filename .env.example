# DSMP environment configuration (PRD §9.4).
# Copy to .env and adjust. Never commit real secrets.

# SQLite database file. Relative paths are resolved against the prisma/
# directory; use an absolute path in production, e.g. file:/srv/dsh/app.db
DATABASE_URL="file:./dev.db"

# Canonical public origin of the deployed site, no trailing slash
# (e.g. https://danielshabrokh.example). Used for canonical URLs, Open Graph
# tags, robots.txt and the sitemap. Leave empty in development to fall back
# to the request origin.
SITE_BASE_URL=""

# Build-time origin (optional), baked into a production build via
# kit.paths.origin. Leave unset when running behind a reverse proxy that
# sets PROTOCOL_HEADER/HOST_HEADER; set it for direct-to-Node deployments.
# Local production-style testing uses: KIT_ORIGIN=http://localhost:4173
# (export it when building, e.g. `KIT_ORIGIN=... pnpm build`).
KIT_ORIGIN=""

# When the app runs behind a reverse proxy, the Node adapter derives each
# request's origin from these headers instead (configured on the proxy):
#   PROTOCOL_HEADER=x-forwarded-proto
#   HOST_HEADER=x-forwarded-host
# Without them the adapter assumes https.

# No session secret is needed: sessions are opaque random tokens stored
# hashed (SHA-256) in the database, not signed values (PRD §6.4).
# No email/YouTube API variables yet: those integrations are intentionally
# not implemented (see README "Known limitations").

# --- NVIDIA visual-review workflow (pnpm visual:review) ---
# API key from https://build.nvidia.com (account → Setup → Get API Key).
# Read only from the environment; never logged, committed, or sent to the browser.
NVIDIA_API_KEY=""

# Vision-language model used for screenshot review. The model originally
# requested (nvidia/nemotron-nano-12b-v2-vl) reached END OF LIFE on the
# hosted API on 2026-08-26 (verified: HTTP 410) and is refused by the
# workflow. The default below was verified live in the public catalog
# (https://build.nvidia.com/nvidia/nemotron-3.5-super-vl-120b-a12b).
NVIDIA_VISION_MODEL="nvidia/nemotron-3.5-super-vl-120b-a12b"

# Leave empty to use the official endpoint https://integrate.api.nvidia.com/v1.
# Set only to a verified NVIDIA-compatible endpoint.
NVIDIA_VISION_BASE_URL=""

# Local port for the visual-review production server (must be free).
VISUAL_REVIEW_PORT="43940"

# Optional tuning knobs for the visual-review workflow (defaults shown):
# NVIDIA_VISION_TIMEOUT_MS="90000"          per-request timeout (1000–600000)
# NVIDIA_VISION_RETRIES="2"                 bounded retries for transient errors (0–5)
# VISUAL_REVIEW_MAX_IMAGE_BYTES="4194304"   review payload limit in bytes
# VISUAL_REVIEW_ITERATIONS="3"              max fix/review rounds in the agent protocol (1–3)
# VISUAL_REVIEW_REPORT_DIR="tests/visual-review"
