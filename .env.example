# DSMP environment configuration (PRD §9.4).
# Copy to .env and adjust. Never commit real secrets.

# SQLite database file. Relative paths are resolved against the prisma/
# directory; use an absolute path in production, e.g. file:/srv/dsh/app.db
DATABASE_URL="file:./dev.db"

# Canonical public origin of the deployed site, no trailing slash
# (e.g. https://danielshabrokh.example). Used for canonical URLs, Open Graph
# tags, robots.txt and the sitemap. Leave empty in development to fall back
# to the request origin.
SITE_BASE_URL=""

# Build-time origin (optional), baked into a production build via
# kit.paths.origin. Leave unset when running behind a reverse proxy that
# sets PROTOCOL_HEADER/HOST_HEADER; set it for direct-to-Node deployments.
# Local production-style testing uses: KIT_ORIGIN=http://localhost:4173
# (export it when building, e.g. `KIT_ORIGIN=... pnpm build`).
KIT_ORIGIN=""

# When the app runs behind a reverse proxy, the Node adapter derives each
# request's origin from these headers instead (configured on the proxy):
#   PROTOCOL_HEADER=x-forwarded-proto
#   HOST_HEADER=x-forwarded-host
# Without them the adapter assumes https.

# No session secret is needed: sessions are opaque random tokens stored
# hashed (SHA-256) in the database, not signed values (PRD §6.4).
# No email/YouTube API variables yet: those integrations are intentionally
# not implemented (see README "Known limitations").
