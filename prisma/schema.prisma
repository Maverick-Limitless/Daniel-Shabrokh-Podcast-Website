// DSMP — Daniel Shabrokh Media Platform data model (PRD §7).
// SQLite for single-instance deployment; provider/url can move to PostgreSQL
// if deployment requirements change (PRD §9.1).

generator client {
	provider = "prisma-client-js"
}

datasource db {
	provider = "sqlite"
}

model Administrator {
	id                 String    @id @default(cuid())
	username           String    @unique
	passwordHash       String
	// Set on first-time init with a generated temporary credential; the admin
	// must establish a permanent password before normal use (PRD §6.2).
	mustChangePassword Boolean   @default(true)
	createdAt          DateTime  @default(now())
	updatedAt          DateTime  @updatedAt
	passwordChangedAt  DateTime?

	sessions Session[]
}

// Only the SHA-256 hash of the opaque cookie token is stored, so a database
// leak cannot be replayed as a valid session (PRD §6.4).
model Session {
	id              String       @id
	administratorId String
	administrator   Administrator @relation(fields: [administratorId], references: [id], onDelete: Cascade)
	createdAt       DateTime     @default(now())
	lastSeenAt      DateTime     @default(now())
	// Sliding expiry; absolute lifetime is capped in code (7 days from createdAt).
	expiresAt       DateTime

	@@index([expiresAt])
}

model Article {
	id             String    @id @default(cuid())
	title          String
	slug           String    @unique
	excerpt        String    @default("")
	// Markdown source; rendered server-side through a sanitizer (PRD §5.4).
	body           String    @default("")
	coverImage     String?
	// draft | published | archived (validated in application code; SQLite has no enums)
	status         String    @default("draft")
	// Author attribution only when verified (PRD §5.4).
	authorLabel    String?
	category       String?
	tags           String    @default("[]") // JSON string array, validated in app code
	featured       Boolean   @default(false)
	publishedAt    DateTime?
	seoTitle       String?
	seoDescription String?
	createdAt      DateTime  @default(now())
	updatedAt      DateTime  @updatedAt

	@@index([status, publishedAt])
	@@index([category])
}

model Video {
	id             String    @id @default(cuid())
	title          String
	slug           String    @unique
	description    String    @default("")
	provider       String    @default("youtube")
	// Validated against YouTube ID format in app code (PRD §5.2).
	providerVideoId String
	thumbnailUrl   String?
	status         String    @default("draft")
	category       String?
	tags           String    @default("[]")
	featured       Boolean   @default(false)
	publishedAt    DateTime?
	createdAt      DateTime  @default(now())
	updatedAt      DateTime  @updatedAt

	@@index([status, publishedAt])
	@@index([category])
}

model AudioEpisode {
	id              String    @id @default(cuid())
	title           String
	slug            String    @unique
	description     String    @default("")
	// https:// URL or root-relative path (e.g. the labeled dev fixture)
	audioSourceUrl  String
	coverImage      String?
	durationSeconds Int?
	episodeNumber   Int?
	status          String    @default("draft")
	category        String?
	tags            String    @default("[]")
	featured        Boolean   @default(false)
	publishedAt     DateTime?
	createdAt       DateTime  @default(now())
	updatedAt       DateTime  @updatedAt

	@@index([status, publishedAt])
	@@index([category])
}

// Audit trail for administrative events (PRD §6.9). Never stores passwords,
// raw tokens, or session secrets. identifierHash = sha256(username|ip) and is
// used only for login rate-limit lookups (PRD §6.3).
model AdminEvent {
	id             String   @id @default(cuid())
	type           String
	actor          String?
	detail         String?
	identifierHash String?
	createdAt      DateTime @default(now())

	@@index([type, createdAt])
	@@index([identifierHash, createdAt])
}
